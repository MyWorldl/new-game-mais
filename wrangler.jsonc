{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Site estático (sem Worker): a Cloudflare publica só a pasta "site".
  // "name" precisa ser igual ao nome do projeto criado no painel (new-game-mais).
  "name": "new-game-mais",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./site",
    // Comportamento explícito (é o padrão da Cloudflare): /index.html redireciona para / e o que não existe dá 404.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  // Builds de preview da Cloudflare (branches e PRs) rodam `wrangler preview`, que exige este bloco.
  // Vazio basta: herda assets e compatibility_date do topo. Não afeta o `wrangler deploy` da produção.
  "previews": {}
}
